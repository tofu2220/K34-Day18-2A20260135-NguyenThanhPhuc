# cp .env.example .env
# Required for M4 (RAGAS judge), M5 (enrichment), and answer generation.
# Create a key at https://openrouter.ai/settings/keys. Never commit your real key.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Use an exact model slug from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
